def args(directory, **overrides):
    result = dict(result_dir=directory, view="auto", entry_plan="baseline", entry_pose=None,
                  door_condition="unassisted", trial_note="", entry_only=True,
                  observe_only=None, motion_topic="/jarvis/pose")
    result.update(overrides)
    return NS(**result)


def entry_events():
    def e(name, t, **kw):
        return dict(event=name, monotonic=t, ros_stamp=1000+t, **kw)
    return [e("door_wait_start", 1),
            e("door_confirmed", 5, result=dict(latency_ms=750, image_stamp=1004)),
            e("command_issue", 5.2, point="inside"), e("command_accepted", 5.4, point="inside"),
            e("motion_started", 5.9, point="inside", onset_monotonic=5.7, onset_ros_stamp=1005.7),
            e("arrival_reported", 9.7, point="inside"), e("navigation_arrived", 11.7, point="inside"),
            e("motion_measurement_end", 11.71, point="inside", reason="detected")]


class TimingTests(unittest.TestCase):
    def test_return_time_and_actual_heading_are_measured_before_door_wait(self):
        events = [dict(event="observe_confirmed", monotonic=1, result=dict(mode="button_verify")),
                  dict(event="navigation_start", point="origin", monotonic=2, return_no_turn=True, heading_reference_deg=2),
                  dict(event="motion_sample", point="origin", pose=[0, 0, .05]),
                  dict(event="arrival_reported", point="origin", monotonic=6),
                  dict(event="return_heading_verified", point="origin"),
                  dict(event="navigation_arrived", point="origin", monotonic=8),
                  dict(event="door_wait_start", monotonic=8.2)]
        metrics = quant.entry_metrics(events)
        self.assertEqual(metrics["return_navigation_s"], 4)
        self.assertEqual(metrics["return_settle_s"], 2)
        self.assertEqual(metrics["button_to_door_wait_s"], 7.2)
        self.assertEqual(metrics["return_heading_status"], "verified")
        self.assertGreater(metrics["return_max_heading_change_deg"], 0)

    def test_distinguishes_wait_inference_dispatch_feedback_arrival_and_settle(self):
        m = quant.entry_metrics(entry_events())
        self.assertEqual(m["door_wait_to_recognition_s"], 4)
        self.assertEqual(m["door_inference_s"], .75)
        self.assertEqual(m["recognition_to_command_s"], .2)
        self.assertEqual(m["command_call_s"], .2)
        self.assertEqual(m["command_to_motion_s"], .5)
        self.assertEqual(m["motion_to_entry_s"], 4)
        self.assertEqual(m["entry_settle_s"], 2)
        self.assertEqual(m["measurement_status"], "complete")

    def test_exit_door_does_not_contaminate_entry_metrics(self):
        events = entry_events()
        events += [dict(event="door_wait_start", monotonic=20, ros_stamp=1020),
                   dict(event="door_confirmed", monotonic=40, ros_stamp=1040, result=dict(latency_ms=9999))]
        self.assertEqual(quant.entry_metrics(events), quant.entry_metrics(entry_events()))

    def test_absent_feedback_remains_null_and_incomplete(self):
        events = [e for e in entry_events() if e["event"] != "motion_started"]
        m = quant.entry_metrics(events)
        self.assertIsNone(m["command_to_motion_s"])
        self.assertIsNone(m["motion_to_entry_s"])
        self.assertEqual(m["measurement_status"], "incomplete")
        self.assertEqual(quant.entry_metrics([])["measurement_status"], "entry_not_started")

    def test_bad_clock_order_is_not_clamped_to_zero(self):
        self.assertIsNone(quant.elapsed(dict(monotonic=1), dict(monotonic=2)))


class RecorderTests(unittest.TestCase):
    def test_door_sequence_backfills_cached_frames_and_preserves_source_timestamps(self):
        with tempfile.TemporaryDirectory() as directory:
            session = self.session(directory)
            for stamp in (999.9, 1000, 1000.05, 1000.11, 1001.1):
                session.frames[stamp] = b"qa-frame"
            event = dict(event="door_wait_start", ros_stamp=1001, run_id=session.run_id, event_sequence=1)
            session.on_line(quant.EVENT_PREFIX + json.dumps(event))
            self.assertEqual([r["image_stamp"] for r in session.door_frames], [1000, 1000.11, 1001.1])
            session.door_window["end_ros_stamp"] = 1002
            session.frames[1002.1] = b"after-window"
            session.record_door_frame(1002.1)
            session.close(130)
            index = json.loads((session.directory / "door_frames.json").read_text(encoding="utf-8"))
            self.assertEqual(len(index["frames"]), 3)
            self.assertEqual(index["frames"][0]["offset_s"], -1)
            self.assertTrue(all((session.directory / r["image"]).is_file() for r in index["frames"]))

    def test_manual_open_frame_produces_delay_interval_and_keeps_early_confirmation(self):
        for recognized, expected in ((1005, 3), (1001, -1), (None, None)):
            with self.subTest(recognized=recognized), tempfile.TemporaryDirectory() as directory:
                session = self.session(directory)
                session.close(0)
                summary_path = session.directory / "summary.json"
                summary = json.loads(summary_path.read_text(encoding="utf-8"))
                summary["metrics"]["door_confirmed_ros_stamp"] = recognized
                quant.write_json(summary_path, summary)
                trial = dict(actual_door_condition="unassisted", entry_success=None,
                             actual_door_open_ros_stamp=1002, actual_door_open_prev_ros_stamp=1001.9, note="QA")
                quant.write_json(session.directory / "trial_review.json", trial)
                result = quant.review_run(session.directory)
                self.assertEqual(result["actual_door_open_to_recognition_s"], expected)
                if recognized is not None:
                    self.assertAlmostEqual(result["actual_door_open_to_recognition_interval_s"]["max_exclusive"], expected+.1)
                    self.assertEqual(result["door_confirmation_precedes_marked_open_frame"], expected < 0)
                else:
                    self.assertIsNone(result["actual_door_open_to_recognition_interval_s"])

    def test_invalid_frame_order_or_foreign_run_timestamp_is_rejected(self):
        with tempfile.TemporaryDirectory() as directory:
            session = self.session(directory)
            session.close(0)
            trial = dict(actual_door_condition="unknown", entry_success=None,
                         actual_door_open_ros_stamp=1002, actual_door_open_prev_ros_stamp=1003, note="")
            quant.write_json(session.directory / "trial_review.json", trial)
            with self.assertRaises(ValueError):
                quant.review_run(session.directory)
            trial.update(actual_door_open_prev_ros_stamp=None, door_time_annotation_source="camera_frame_review")
            quant.write_json(session.directory / "trial_review.json", trial)
            with self.assertRaises(ValueError):
                quant.review_run(session.directory)

    def test_old_sparse_run_reports_no_continuous_frames_instead_of_fabricating_them(self):
        with tempfile.TemporaryDirectory() as directory:
            session = self.session(directory)
            session.close(0)
            (session.directory / "door_frames.json").unlink()
            quant.render_door_review(session.directory)
            page = (session.directory / "door_review.html").read_text(encoding="utf-8")
            self.assertIn('"frames": []', page)
            self.assertIn("无法补回精确开门时刻", page)

    def session(self, directory, **overrides):
        session = quant.QuantificationSession(args(directory, **overrides), controller.load_config())
        session.rospy = NS(Time=NS(now=lambda: NS(to_sec=lambda: 1010)))
        session.start_ros = 1000
        return session

    def observation(self, session, seq=1, stamp=1002, **updates):
        payload = dict(schema_version=2, sequence=seq, image_stamp=stamp, mode="door_monitor",
                       status="ok", door_closed=False, confidence=dict(door_closed=.95), latency_ms=50)
        payload.update(updates)
        session.on_state("door", NS(data=json.dumps(payload)))

    def test_duplicates_heartbeats_and_previous_run_results_are_ignored(self):
        with tempfile.TemporaryDirectory() as directory:
            session = self.session(directory)
            self.observation(session, stamp=999)
            self.observation(session, message_type="heartbeat")
            self.observation(session)
            self.observation(session)
            self.assertEqual(len(session.observations), 1)
            session.close(130)
            summary = json.loads((session.directory / "summary.json").read_text(encoding="utf-8"))
            self.assertEqual(summary["exit_code"], 130)
            self.assertEqual(summary["exact_image_count"], 0)
            self.assertEqual(session.observations[0]["image_match"], "missing")
            self.assertTrue((session.directory / "report.html").is_file())

    def test_nearby_camera_frame_is_never_substituted_for_exact_inference_frame(self):
        with tempfile.TemporaryDirectory() as directory:
            session = self.session(directory)
            session.frames[1002.01] = b"neighbor"
            self.observation(session)
            self.assertFalse(session.observations[0]["image"])
            session.frames[1003] = b"exact"
            self.observation(session, seq=2, stamp=1003)
            image = session.observations[1]["image"]
            self.assertEqual((session.directory / image).read_bytes(), b"exact")
            session.close(0)

    def test_event_gap_fails_recorder_and_final_report_marks_incomplete(self):
        with tempfile.TemporaryDirectory() as directory:
            session = self.session(directory)
            event = dict(event="command_issue", point="inside", monotonic=1, ros_stamp=1001,
                         run_id=session.run_id, event_sequence=2)
            session.on_line(quant.EVENT_PREFIX + json.dumps(event))
            self.assertIsNotNone(session.fatal)
            session.close(1)
            summary = json.loads((session.directory / "summary.json").read_text(encoding="utf-8"))
            self.assertEqual(summary["metrics"]["measurement_status"], "incomplete")

    def test_human_labels_do_not_equate_high_confidence_with_correct(self):
        with tempfile.TemporaryDirectory() as directory:
            session = self.session(directory)
            for seq, updates in enumerate(({}, {}, dict(door_closed=None, status="uncertain"), {}), 1):
                self.observation(session, seq=seq, stamp=1000+seq, **updates)
            session.close(130)
            path = session.directory / "labels.csv"
            with path.open(encoding="utf-8-sig", newline="") as stream:
                rows = list(csv.DictReader(stream))
            for row, truth in zip(rows, ("false", "true", "false", "null")):
                row["ground_truth"] = truth
            quant.write_csv(path, rows, list(rows[0]))
            reviewed = quant.review_run(session.directory)
            counts = reviewed["review_counts"]["door_monitor/unverified"]
            self.assertEqual((counts["correct"], counts["incorrect"], counts["abstained"], counts["ground_truth_unknown"]), (1, 1, 1, 1))
            self.assertEqual(counts["accuracy_including_abstentions"], 1/3)
            self.assertEqual(counts["accuracy_on_answered"], .5)
            self.assertEqual(counts["coverage"], 2/3)

    def test_aggregate_separates_points_and_actual_door_conditions(self):
        with tempfile.TemporaryDirectory() as directory:
            for n, condition in enumerate(("unassisted", "held")):
                session = self.session(directory)
                session.events = entry_events()
                for seq, e in enumerate(session.events, 1):
                    e["event_sequence"] = seq
                session.close(0)
                trial = dict(actual_door_condition=condition, entry_success=n==0, actual_door_open_ros_stamp=1002, note="verified")
                quant.write_json(session.directory / "trial_review.json", trial)
                quant.review_run(session.directory)
            result = quant.aggregate(Path(directory))
            self.assertEqual(len(result), 2)
            self.assertEqual(sorted(g["success_rate"] for g in result.values()), [0, 1])


class MotionTests(unittest.TestCase):
    def test_missing_publisher_is_reported_before_subscribing_or_sending_commands(self):
        rosgraph = NS(Master=lambda name: NS(getSystemState=lambda: ([], [], [])))
        rostopic = NS(get_topic_class=Mock())
        runtime = NS(rospy=NS(get_name=lambda: '/readonly_motion_test', Subscriber=Mock()))
        with patch.dict(sys.modules, dict(rosgraph=rosgraph, rostopic=rostopic)), \
                self.assertRaisesRegex(RuntimeError, "没有发布者"):
            controller.MotionMonitor(runtime, "/tracked_pose")
        runtime.rospy.Subscriber.assert_not_called()
        rostopic.get_topic_class.assert_not_called()

    def test_changed_heading_or_lost_feedback_prevents_door_phase(self):
        monitor = self.monitor()
        monitor.pending["heading_tolerance_rad"] = .0873
        monitor.pending["max_heading_error_rad"] = .2
        with patch.object(controller.time, "monotonic", return_value=20.4), self.assertRaises(RuntimeError):
            monitor.verify_heading()
        monitor.pending["max_heading_error_rad"] = .01
        with patch.object(controller.time, "monotonic", return_value=21), self.assertRaises(RuntimeError):
            monitor.verify_heading()
        with patch.object(controller.time, "monotonic", return_value=20.4):
            monitor.verify_heading()

    def monitor(self):
        monitor = controller.MotionMonitor.__new__(controller.MotionMonitor)
        monitor.runtime = NS(now=lambda: 1000.4, record=Mock())
        monitor.topic, monitor.distance, monitor.angle = "/jarvis/pose", .015, .03
        monitor.lock, monitor.samples = threading.RLock(), []
        baseline = dict(pose=(0, 0, 0), stamp=1000.01, mono=20, frame="map")
        monitor.pending = dict(point="inside", baseline=baseline, previous=baseline, armed_ros=1000.02, above=[])
        return monitor

    def sample(self, monitor, stamp, x, frame="map", mono=20.1):
        message = NS(header=NS(stamp=NS(to_sec=lambda: stamp), frame_id=frame),
                     pose=NS(position=NS(x=x, y=0), orientation=NS(x=0, y=0, z=0, w=1)))
        with patch.object(controller.time, "monotonic", return_value=mono):
            monitor.on_sample(message)

    def test_requires_three_distinct_fresh_position_samples_above_threshold(self):
        monitor = self.monitor()
        self.sample(monitor, 999, 10)
        self.sample(monitor, 1000.01, .02)
        self.sample(monitor, 1000.1, .005, mono=20.1)
        self.sample(monitor, 1000.2, .02, mono=20.2)
        self.sample(monitor, 1000.2, .03, mono=20.21)
        self.sample(monitor, 1000.3, .03, mono=20.3)
        self.assertFalse(monitor.pending.get("detected"))
        self.sample(monitor, 1000.4, .04, mono=20.4)
        events = [call for call in monitor.runtime.record.call_args_list if call.args[0] == "motion_started"]
        self.assertEqual(len(events), 1)
        self.assertEqual(events[0].kwargs["onset_monotonic"], 20.2)

    def test_map_frame_change_or_position_jump_invalidates_measurement(self):
        for frame, x in (("odom", .02), ("map", 1)):
            monitor = self.monitor()
            self.sample(monitor, 1000.2, x, frame=frame)
            self.assertTrue(monitor.pending.get("invalid"))
            self.assertFalse(monitor.pending.get("detected"))


class QuantifiedWorkflowTests(unittest.TestCase):
    def test_origin_no_turn_needs_no_new_coordinates_and_does_not_modify_site(self):
        config = controller.load_config()
        original = copy.deepcopy(config)
        self.assertEqual(controller.configure_entry(config, "origin_no_turn"), ("origin", True))
        self.assertEqual(config, original)

    def test_no_turn_changes_only_return_leg_and_retains_measured_door_heading(self):
        import math
        config = controller.load_config()
        for point in ("button", "inside", "exit"):
            pose, options, held = controller.return_navigation(config, point, math.radians(2), True)
            self.assertTrue(options["allow_rotation"])
            self.assertFalse(held)
            self.assertEqual(pose, config["points"][point])
        pose, options, held = controller.return_navigation(config, "origin", math.radians(2), True)
        self.assertTrue(held)
        self.assertFalse(options["allow_rotation"])
        self.assertAlmostEqual(pose["theta"], 2)
        self.assertEqual((pose["x"], pose["y"]), (-3.465, -.216))
        self.assertTrue(config["navigation"]["allow_rotation"])

    def test_wrong_start_direction_and_rejected_center_shift_never_send_return(self):
        config = controller.load_config()
        with self.assertRaises(RuntimeError):
            controller.return_navigation(config, "origin", 3.14, True)
        for plan, pose in (("center_shift", [0, 0, 0]),
                           ("origin_no_turn", [0, 0, 0]), ("reduced_backtrack", [-1, 0, 90])):
            with self.subTest(plan=plan, pose=pose), self.assertRaises(ValueError):
                controller.configure_entry(config, plan, pose)

    def test_confirmed_millimetre_coordinates_and_six_degree_heading_are_defaults(self):
        import math
        config = controller.load_config()
        point, hold = controller.configure_entry(config, "reduced_backtrack")
        self.assertEqual((point, hold), ("entry_wait", True))
        self.assertEqual(config["points"][point], dict(x=-.901, y=.004, theta=6))
        for name in ("origin", "entry_wait"):
            pose, options, held = controller.return_navigation(config, name, math.radians(6), True)
            self.assertTrue(held)
            self.assertFalse(options["allow_rotation"])
            self.assertAlmostEqual(pose["theta"], 6)

    def test_quantification_default_is_origin_no_turn_and_old_demo_remains_baseline(self):
        with tempfile.TemporaryDirectory() as directory:
            fake = NS(root=Path(directory), run=Mock(return_value=0), close=Mock())
            fcntl = NS(flock=lambda *a: None, LOCK_EX=2, LOCK_NB=4)
            for arguments, expected in ((["--program", "quantify", "--check"], "origin_no_turn"),
                                        (["--check"], "baseline"),
                                        (["--program", "quantify", "--observe-only", "door"], "baseline")):
                signals = NS(SIGINT=2, SIGTERM=15, SIGHUP=1, SIG_IGN=1, signal=Mock())
                with patch.object(launcher, "fcntl", fcntl), patch.object(launcher, "signal", signals), \
                        patch.object(launcher, "Launcher", return_value=fake) as create:
                    self.assertEqual(launcher.main(arguments), 0)
                    self.assertEqual(create.call_args.args[0].entry_plan, expected)
                    self.assertEqual(create.call_args.args[0].motion_topic, "/jarvis/pose")

    def test_preflight_preview_passes_selected_floor_plan_and_feedback_without_running(self):
        import os,shlex
        with tempfile.TemporaryDirectory() as directory:
            instance = launcher_tests.SequenceTests().make_launcher(directory, program="quantify", target_floor=15,
                **vars(args(directory, entry_plan="reduced_backtrack")))
            del instance.preflight
            instance.remote.side_effect = [json.dumps(dict(config=controller.load_config(), active_pids=[])),
                                           "runtime ready\n", "preview ready\n"]
            instance.args.check_startup = True  # Skip live hardware discovery, while still checking preview flags.
            with patch.object(Path, "is_file", return_value=True), \
                    patch.dict(os.environ, {"ROS_MASTER_URI": "http://kuavo_master:11311"}):
                instance.preflight()
            command = shlex.split(instance.remote.call_args.args[0])
            self.assertIn("--quantify", command)
            for flag, value in (("--target-floor", "15"), ("--entry-plan", "reduced_backtrack"),
                                ("--motion-topic", "/jarvis/pose")):
                self.assertEqual(command[command.index(flag)+1], value)
            self.assertNotIn("--run", command)
            self.assertNotIn("--observe-only", command)

    def test_observation_launch_never_selects_motion_or_navigation_check(self):
        with tempfile.TemporaryDirectory() as directory:
            instance = launcher_tests.SequenceTests().make_launcher(directory, program="quantify", **vars(args(directory,
                observe_only="door", entry_only=False, view="normal")))
            instance.config = controller.load_config()
            fake = NS(process=NS(poll=lambda: 0, returncode=0))
            with patch.dict(sys.modules, {"elevator_quantification": quant}), \
                    patch.object(quant.QuantificationSession, "start"), \
                    patch.dict("os.environ", {"ROS_MASTER_URI": "http://kuavo_master:11311"}), \
                    patch.object(launcher, "Child", return_value=fake) as child:
                self.assertEqual(instance.run(), 0)
            command = child.call_args.args[1][-1]
            self.assertIn("--observe-only door", command)
            self.assertNotIn("--run ", command)
            instance.remote.assert_not_called()
            instance.recorder.close(0)

    def test_custom_wait_point_and_entry_only_use_same_fresh_door_gate(self):
        runtime = controller.MockRuntime()
        controller.execute_demo(runtime, "entry_wait", entry_only=True)
        self.assertIn(("navigate", "entry_wait"), runtime.events)
        self.assertNotIn(("navigate", "origin"), runtime.events)
        self.assertLess(runtime.events.index(("wait", "door_fully_open")), runtime.events.index(("navigate", "inside")))
        self.assertNotIn(("head", "floor"), runtime.events)
        self.assertEqual(runtime.events[-1], ("close",))

    def test_launcher_passes_quantification_arguments_and_keeps_logs_in_result(self):
        with tempfile.TemporaryDirectory() as directory:
            instance = launcher_tests.SequenceTests().make_launcher(directory, program="quantify", **vars(args(directory,
                entry_plan="reduced_backtrack", entry_pose=[-.5, .2, 0])))
            instance.config = controller.load_config()
            fake = NS(process=NS(poll=lambda: 0, returncode=0))
            with patch.dict(sys.modules, {"elevator_quantification": quant}), \
                    patch.object(quant.QuantificationSession, "start"), \
                    patch.dict("os.environ", {"ROS_MASTER_URI": "http://kuavo_master:11311"}), \
                    patch.object(launcher, "Child", return_value=fake) as child:
                self.assertEqual(instance.run(), 0)
            command = child.call_args.args[1][-1]
            for flag in ("--quantify", "--entry-plan reduced_backtrack", "--entry-pose -0.5 0.2 0", "--entry-only"):
                self.assertIn(flag, command)
            self.assertIn(Path(directory), instance.logs.parents)
            instance.recorder.close(0)


