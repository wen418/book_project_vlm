def check_connections(rospy, config, require_perception=True):
    """Read-only discovery and camera check. Never calls navigation/head services."""
    import rosgraph
    from sensor_msgs.msg import Image
    from std_msgs.msg import String
    publishers, subscribers, services = rosgraph.Master(rospy.get_name()).getSystemState()
    publishers, subscribers, services = dict(publishers), dict(subscribers), dict(services)
    p = config["perception"]
    required = [config["camera"]["topic"]]
    if require_perception:
        required += [p["door_state_topic"], p["extra_state_topic"], p["extra_ready_topic"]]
    missing = [name for name in required if not publishers.get(name)]
    for name in ("/move_base/move_to_target", "/move_base/check_arrived"):
        if not services.get(name):
            missing.append(name)
    if not subscribers.get("/robot_head_motion_data"):
        missing.append("/robot_head_motion_data 的订阅者")
    if missing:
        raise RuntimeError("缺少连接：" + ", ".join(missing))
    if require_perception:
        for name in (p["door_mode_topic"], p["extra_request_topic"]):
            if not subscribers.get(name):
                raise RuntimeError("感知程序未订阅 " + name)
        ready = json.loads(rospy.wait_for_message(p["extra_ready_topic"], String, timeout=5).data)
        if ready.get("schema_version") != 1 or not {"button_verify", "floor_monitor"}.issubset(ready.get("capabilities", [])):
            raise RuntimeError("附加感知接口不兼容")
    message = rospy.wait_for_message(config["camera"]["topic"], Image, timeout=5)
    stamp = message.header.stamp.to_sec()
    if (message.height <= 0 or message.width <= 0 or message.step <= 0 or
            len(message.data) < message.height * message.step or stamp <= 0 or
            not -1 <= rospy.Time.now().to_sec() - stamp <= config["extra_perception"]["max_frame_age"]):
        raise RuntimeError("相机图像不完整、过期或时间戳异常")
    if publishers.get("/robot_head_motion_data"):
        print("头部话题当前发布者：" + ", ".join(publishers["/robot_head_motion_data"]))
        print("完整演示时应停止其他持续发送头部姿态的程序，否则会覆盖本演示视角。")
    print(f"相机连通：{message.width}x{message.height}，{message.encoding}；导航及头部接口已找到。")


def import_robot_api(config):
    book = Path(config["book_dir"])
    if not (book / "api.py").is_file():
        raise RuntimeError("未找到 book/api.py，请通过 --book-dir 指定现有生产接口目录")
    sys.path.insert(0, str(book))
    import api
    if Path(api.__file__).resolve() != (book / "api.py").resolve():
        raise RuntimeError("导入了错误的 api.py")
    return api


def move_head(api, head, pose, wait_seconds, rospy, status, name):
    """Tick the existing NodeHeadMove, which sends once and waits (no pose feedback)."""
    deadline = time.monotonic() + 2
    while head.head_pub.get_num_connections() == 0:
        if rospy.is_shutdown() or time.monotonic() >= deadline:
            raise RuntimeError("头部话题没有订阅者，未发送头部指令")
        time.sleep(0.05)
    node = api.NodeHeadMove(name=name, head_api=head, yaw=pose["yaw"],
                            pitch=pose["pitch"], wait_time=wait_seconds)
    deadline = time.monotonic() + wait_seconds + 5
    try:
        while True:
            if rospy.is_shutdown():
                raise RuntimeError("ROS 已关闭，头部动作中止")
            if time.monotonic() >= deadline:
                raise TimeoutError("等待 NodeHeadMove 超时")
            node.tick_once()
            if node.status == status.SUCCESS:
                return
            if node.status == status.FAILURE:
                raise RuntimeError("NodeHeadMove 返回失败")
            time.sleep(0.05)
    finally:
        if node.status == status.RUNNING:
            node.stop(status.INVALID)


class LiveRuntime:
    def __init__(self, config, log_dir, perception_required=True):
        import rospy
        from py_trees.common import Status
        from std_msgs.msg import String
        self.config, self.rospy, self.Status, self.String = config, rospy, Status, String
        self.api = import_robot_api(config)
        check_connections(rospy, config, require_perception=perception_required)
        self.head = self.api.HeadAPI(None)  # Current HeadAPI publishes directly; it does not use robot_sdk.
        p = config["perception"]
        self.door_pub = rospy.Publisher(p["door_mode_topic"], String, queue_size=1, latch=True)
        self.extra_pub = rospy.Publisher(p["extra_request_topic"], String, queue_size=1, latch=True)
        self.gates = {}
        for name in ("button", "floor", "door"):
            rule = p[name]
            self.gates[name] = EvidenceGate(p["max_result_age"], p["min_confidence"],
                                            rule["confirmations"], rule["min_span"])
        self.subscribers = [
            rospy.Subscriber(p["door_state_topic"], String, lambda msg: self.on_state("door", msg), queue_size=10),
            rospy.Subscriber(p["extra_state_topic"], String, self.on_extra, queue_size=10),
        ]
        log_dir.mkdir(parents=True, exist_ok=True)
        self.log_path = log_dir / (datetime.now().strftime("elevator_%Y%m%d_%H%M%S_") + uuid.uuid4().hex[:6] + ".jsonl")
        self.current_request = None
        self.pause(0.5)

    def record(self, event, **data):
        with self.log_path.open("a", encoding="utf-8") as stream:
            stream.write(json.dumps({"system_stamp": time.time(), "ros_stamp": self.now(),
                                     "event": event, **data}, ensure_ascii=False, allow_nan=False) + "\n")

    def now(self):
        return self.rospy.Time.now().to_sec()

    def on_state(self, name, message):
        gate = self.gates[name]
        gate.feed(message.data, self.now())
        self.rospy.loginfo_throttle(2, "%s: %s", name, gate.reason)

    def on_extra(self, message):
        for name in ("button", "floor"):
            self.on_state(name, message)

    def pause(self, seconds):
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            if self.rospy.is_shutdown():
                raise RuntimeError("ROS 已关闭")
            time.sleep(min(0.05, max(0, deadline - time.monotonic())))

    def extra_request(self, mode, stamp=None):
        request = {"request_id": uuid.uuid4().hex, "mode": mode,
                   "not_before_stamp": self.now() if stamp is None else stamp}
        self.current_request = request
        self.extra_pub.publish(self.String(data=json.dumps(request)))
        return request

    def idle(self):
        self.door_pub.publish(self.String(data="idle"))
        self.extra_request("idle")

    def look(self, name):
        self.idle()  # In-flight inference is invalidated before moving the head.
        pose = self.config["head"][name]
        self.record("head", view=name, **pose)
        move_head(self.api, self.head, pose, self.config["head_settle_seconds"],
                  self.rospy, self.Status, "ElevatorDemo_Look_" + name)

    def wait_extra(self, name, mode, field, expected):
        self.door_pub.publish(self.String(data="idle"))
        stamp = self.now()  # Only frames captured after head settling may satisfy the gate.
        request_id = uuid.uuid4().hex
        request = {"request_id": request_id, "mode": mode, "not_before_stamp": stamp}
        gate = self.gates[name]
        gate.arm(mode, field, expected, stamp, request_id=request_id)
        self.current_request = request
        self.extra_pub.publish(self.String(data=json.dumps(request)))
        self.record("observe_start", **request, expected=expected)
        result = gate.wait(self.config["perception"][name + "_timeout"], self.now, self.rospy.is_shutdown)
        self.record("observe_confirmed", result=result)
        return result

    def wait_button(self):
        return self.wait_extra("button", "button_verify", "button_lit", True)

    def wait_floor(self):
        return self.wait_extra("floor", "floor_monitor", "floor", self.config["target_floor"])

    def wait_door(self):
        self.extra_request("idle")
        gate = self.gates["door"]
        gate.arm("door_monitor", "door_closed", False, self.now(), schema_version=2)
        self.door_pub.publish(self.String(data="door_monitor"))
        self.record("door_wait_start")
        result = gate.wait(self.config["perception"]["door_timeout"], self.now, self.rospy.is_shutdown)
        self.record("door_confirmed", result=result)
        return result

    def navigate(self, name):
        self.idle()
        pose = self.config["points"][name]
        options = dict(self.config["navigation"])
        timeout = options.pop("timeout")
        sender = self.api.NodeNavigationToTarget(name="ElevatorDemo_" + name, **pose, **options)
        waiter = self.api.NodeWaitForArrival("ElevatorDemo_" + name + "_Arrival", timeout=timeout)
        deadline = time.monotonic() + timeout
        self.record("navigation_start", point=name, pose=pose)
        try:
            for node in (sender, waiter):
                while True:
                    if self.rospy.is_shutdown() or time.monotonic() >= deadline:
                        return False
                    node.tick_once()
                    if node.status == self.Status.SUCCESS:
                        break
                    if node.status == self.Status.FAILURE:
                        return False
                    time.sleep(0.05)
            self.pause(self.config["settle_seconds"])
            self.record("navigation_arrived", point=name)
            return True
        finally:
            for node in (sender, waiter):
                if node.status == self.Status.RUNNING:
                    node.stop(self.Status.INVALID)

    def close(self):
        try:
            self.idle()
            self.record("finished_or_aborted")
            if not self.rospy.is_shutdown():
                self.pause(0.2)
        finally:
            for subscriber in self.subscribers:
                subscriber.unregister()
            print("运行记录：" + str(self.log_path))


class MockRuntime:
    def __init__(self):
        self.events = []

    def navigate(self, point):
        self.events.append(("navigate", point))
        return True

    def look(self, view):
        self.events.append(("head", view))

    def idle(self):
        self.events.append(("mode", "idle"))

    def wait_button(self):
        self.events.append(("wait", "down_button_lit"))

    def wait_floor(self):
        self.events.append(("wait", "floor_20"))

    def wait_door(self):
        self.events.append(("wait", "door_fully_open"))

    def close(self):
        self.events.append(("close",))


def validate_live(config, args):
    if config["calibrated"] is not True:
        raise ValueError("新按钮坐标/头部视角尚未标定；核对后将本文件 DEFAULT_CONFIG 的 calibrated 改为 True")
    if not (args.preflight_confirmed and args.perception_confirmed and args.estop_ready):
        raise ValueError("实机沿用原程序三个参数：--preflight-confirmed --perception-confirmed --estop-ready")


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, help="可选外部 JSON；默认使用本文件 DEFAULT_CONFIG")
    parser.add_argument("--book-dir", type=Path)
    parser.add_argument("--log-dir", type=Path, default=ROOT / "logs")
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--run", action="store_true")
    modes.add_argument("--mock", action="store_true")
    modes.add_argument("--check-services", action="store_true")
    modes.add_argument("--observe-only", choices=("button", "floor", "door"), help="保持现有姿态，仅测试感知；不导航、不转头")
    modes.add_argument("--head-only", choices=("button", "floor", "door"), help="只发送一次头部姿态，不导航；用于标定")
    for name in ("preflight-confirmed", "perception-confirmed", "estop-ready"):
        parser.add_argument("--" + name, action="store_true")
    args = parser.parse_args(argv)
    config = load_config(args.config)
    print("参数来源：" + (str(args.config) if args.config else "本文件 DEFAULT_CONFIG（内置）"))
    if args.book_dir:
        config["book_dir"] = str(args.book_dir)
    if args.mock:
        runtime = MockRuntime()
        execute_demo(runtime)
        print("[MOCK] " + " -> ".join(map(str, runtime.events)))
        print("模拟完成；未连接 ROS、未发送运动或真实感知请求。")
        return 0
    if not any((args.run, args.check_services, args.observe_only, args.head_only)):
        print("仅预览：未连接机器人。导航单位为米，角度为度。")
        for name, pose in config["points"].items():
            print(name, pose)
        print("头部姿态：", config["head"])
        print("目标楼层：20；厅外下行按钮未亮则等待；本程序不按任何按钮。")
        print("20 楼按用户说明复用 21floorrr 局部坐标；不切图、不改楼层记录。")
        print("新点位/视角标定状态：", config["calibrated"])
        return 0
    if args.run:
        validate_live(config, args)
    if args.head_only and not args.estop_ready:
        raise ValueError("头部标定需沿用 --estop-ready；本模式不移动底盘")
    import rospy
    rospy.init_node("elevator_button_floor_demo", anonymous=True, disable_signals=True)
    signal.signal(signal.SIGINT, signal.default_int_handler)
    signal.signal(signal.SIGTERM, signal.default_int_handler)
    if args.check_services:
        check_connections(rospy, config)
        print("只读连接检查完成；未发送导航、头部、按键或切图指令。")
        return 0
    if args.head_only:
        from py_trees.common import Status
        api = import_robot_api(config)
        head = api.HeadAPI(None)
        pose = config["head"][args.head_only]
        move_head(api, head, pose, config["head_settle_seconds"],
                  rospy, Status, "ElevatorDemo_Calibrate_" + args.head_only)
        print("仅头部标定完成；未移动底盘。")
        return 0
    runtime = LiveRuntime(config, args.log_dir)
    if args.observe_only:
        try:
            runtime.idle()
            result = {"button": runtime.wait_button, "floor": runtime.wait_floor, "door": runtime.wait_door}[args.observe_only]()
            print(json.dumps(result, ensure_ascii=False))
        finally:
            runtime.close()
    else:
        execute_demo(runtime)
        print("单轮演示完成。")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("测试中断；退出脚本不保证底盘停车，沿用原程序的现场急停处理。")
        raise SystemExit(130)
    except Exception as error:
        print("测试未启动或已终止：" + str(error), file=sys.stderr)
        raise SystemExit(1)
