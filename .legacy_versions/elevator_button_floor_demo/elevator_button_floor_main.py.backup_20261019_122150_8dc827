def finite(value, name, low=None, high=None):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise ValueError(f"{name} 必须是数值")
    result = float(value)
    if not math.isfinite(result) or (low is not None and result < low) or (high is not None and result > high):
        raise ValueError(f"{name} 超出范围或不是有限数值")
    return result

def validate_config(config):
    if type(config.get("target_floor")) is not int or not -10 <= config["target_floor"] <= 150:
        raise ValueError("target_floor 必须为 -10 到 150 的整数楼层，与当前楼层识别接口一致")
    if config.get("coordinate_unit") != "m" or config.get("angle_unit") != "deg":
        raise ValueError("本测试只接受米制坐标和度制角度")
    if type(config.get("calibrated")) is not bool:
        raise ValueError("calibrated 必须是布尔值")
    for name in ("origin", "button", "inside", "exit"):
        pose = config["points"][name]
        for axis in ("x", "y"):
            finite(pose[axis], f"points.{name}.{axis}")
        finite(pose["theta"], f"points.{name}.theta", -180, 180)
    for name in ("button", "floor", "door"):
        pose = config["head"][name]
        for axis, limits in HEAD_COMMAND_LIMITS.items():
            finite(pose[axis], f"head.{name}.{axis}", *limits)
    if not isinstance(config.get("map_name"), str) or not config["map_name"]:
        raise ValueError("必须记录局部地图名")
    nav = config["navigation"]
    if type(nav["avoid_enabled"]) is not bool or nav["allow_rotation"] is not True:
        raise ValueError("导航参数无效")
    for key, low, high in (("linear_velocity", 0.01, 0.7), ("angular_velocity", 0.01, 0.4),
                          ("position_threshold", 0.001, 0.1), ("angle_threshold", 0.001, 0.1),
                          ("timeout", 1, 300)):
        finite(nav[key], "navigation." + key, low, high)
    perception = config["perception"]
    for key in ("button_timeout", "floor_timeout", "door_timeout"):
        finite(perception[key], "perception." + key, 1, 1800)
    finite(perception["max_result_age"], "max_result_age", 0.1, 60)
    finite(perception["min_confidence"], "min_confidence", 0, 1)
    for mode in ("button", "floor", "door"):
        rule = perception[mode]
        if type(rule["confirmations"]) is not int or not 1 <= rule["confirmations"] <= 10:
            raise ValueError("confirmations 必须为 1 到 10 的整数")
        finite(rule["min_span"], "min_span", 0, 30)
    for key in ("settle_seconds", "head_settle_seconds"):
        finite(config[key], key, 0.1, 15)
    camera = config["camera"]
    if camera["yuv422_layout"] not in ("yuyv", "uyvy"):
        raise ValueError("相机字节顺序无效")
    if type(camera["max_image_edge"]) is not int or camera["max_image_edge"] < 0:
        raise ValueError("max_image_edge 必须为非负整数")
    if type(camera["jpeg_quality"]) is not int or not 1 <= camera["jpeg_quality"] <= 100:
        raise ValueError("jpeg_quality 必须为 1 到 100 的整数")
    for name in ("button_roi", "floor_roi"):
        roi = camera[name]
        if roi is not None:
            if (not isinstance(roi, list) or len(roi) != 4 or
                    any(type(v) is not int for v in roi) or min(roi[:2]) < 0 or min(roi[2:]) <= 0):
                raise ValueError(f"camera.{name} 必须为 null 或像素 [x,y,width,height]")
    for key in ("inference_period", "max_frame_age", "max_result_age"):
        finite(config["extra_perception"][key], "extra_perception." + key, 0.1, 60)
    return config

def load_config(path=None):
    """Use embedded defaults unless an external JSON is explicitly requested."""
    config = copy.deepcopy(DEFAULT_CONFIG) if path is None else json.loads(
        Path(path).read_text(encoding="utf-8-sig"))
    return validate_config(config)


class EvidenceGate:
    """Accept distinct fresh frames from the current observation request only."""
    def __init__(self, max_age, min_confidence, confirmations, min_span):
        self.max_age, self.min_confidence = max_age, min_confidence
        self.confirmations, self.min_span = confirmations, min_span
        self.condition = threading.Condition()
        self.mode = None
        self.reason = "尚未开始观察"
        self.last_payload = None
        self.ready = False

    def arm(self, mode, field, expected, not_before, request_id=None, schema_version=1):
        with self.condition:
            self.mode, self.field, self.expected = mode, field, expected
            self.not_before = finite(not_before, "not_before")
            self.request_id, self.schema_version = request_id, schema_version
            self.sequence = None
            self.frame_stamp = None
            self.count, self.first_stamp, self.ready = 0, None, False
            self.last_payload = None
            self.reason = "等待本阶段的新图像"

    def reset(self, reason):
        self.count, self.first_stamp, self.ready = 0, None, False
        self.reason = reason

    def feed(self, text, now):
        with self.condition:
            if self.mode is None:
                return False
            try:
                payload = json.loads(text)
                if not isinstance(payload, dict):
                    raise ValueError("JSON 不是对象")
                # Heartbeats and processing notifications describe the node, not a new observation.
                if payload.get("message_type", "result") != "result":
                    return False
                if self.request_id is not None and payload.get("request_id") != self.request_id:
                    return False  # Late answers to an earlier request are not this request's evidence.
                if payload.get("mode") != self.mode:
                    return False
                if payload.get("schema_version") != self.schema_version or payload.get("status") != "ok":
                    raise ValueError("状态未知或接口版本不符")
                seq = payload.get("sequence")
                if type(seq) is not int:
                    raise ValueError("sequence 无效")
                if self.sequence is not None and seq <= self.sequence:
                    return False
                self.sequence = seq
                stamp = finite(payload.get("image_stamp"), "image_stamp")
                age = finite(now, "now") - stamp
                if stamp < self.not_before or age < -1 or age > self.max_age:
                    raise ValueError("图像过期、来自旧阶段或时钟异常")
                if self.frame_stamp is not None and stamp <= self.frame_stamp:
                    return False
                if self.frame_stamp is not None and stamp - self.frame_stamp > self.max_age:
                    self.reset("两次观察间隔过大")
                self.frame_stamp = stamp
                confidence = finite(payload.get("confidence", {}).get(self.field), "confidence", 0, 1)
                observed = payload.get(self.field)
                if (confidence < self.min_confidence or type(observed) is not type(self.expected)
                        or observed != self.expected):
                    raise ValueError(f"尚未确认 {self.field}={self.expected!r}")
                if self.count == 0:
                    self.first_stamp = stamp
                self.count += 1
                self.ready = self.count >= self.confirmations and stamp - self.first_stamp >= self.min_span
                self.last_payload = payload
                self.reason = f"确认 {self.count}/{self.confirmations} 次，图像跨度 {stamp - self.first_stamp:.1f}s"
            except (ValueError, TypeError, AttributeError) as exc:
                self.reset(str(exc))
            self.condition.notify_all()
            return self.ready

    def wait(self, timeout, now_fn, stopped=lambda: False):
        deadline = time.monotonic() + timeout
        with self.condition:
            while True:
                if stopped():
                    raise RuntimeError("ROS 已关闭")
                if self.ready:
                    age = now_fn() - self.last_payload["image_stamp"]
                    if -1 <= age <= self.max_age:
                        return self.last_payload
                    self.reset("已确认的结果在执行前过期")
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError("等待超时：" + self.reason)
                self.condition.wait(min(0.2, remaining))

def execute_demo(runtime, entry_point="origin", entry_only=False):
    """Business sequence requested for this demonstration, not an LLM planner."""
    target_floor = runtime.target_floor
    def require(result, label):
        if result is not True:
            raise RuntimeError(label + "未完成，后续步骤已取消")

    try:
        runtime.idle()
        print("[1/6] 从原点前往厅外按钮观察点", flush=True)
        require(runtime.navigate("button"), "前往按钮点")
        runtime.look("button")
        print("[2/6] 等待下行按钮点亮；未亮/未知时原地等待，不自动按键", flush=True)
        runtime.wait_button()
        runtime.idle()
        runtime.look("door")
        require(runtime.navigate(entry_point), "前往进梯观察点")
        print("[3/6] 等待门完整打开后进入，并转身面向门", flush=True)
        runtime.wait_door()
        runtime.idle()
        require(runtime.navigate("inside"), "进入电梯")
        if entry_only:
            return
        print(f"[4/6] 头部看右上方，等待显示 {target_floor} 楼", flush=True)
        runtime.look("floor")
        runtime.wait_floor()
        runtime.idle()
        print(f"[5/6] 确认 {target_floor} 楼后，转头面向门，等待新画面确认完整开门", flush=True)
        runtime.look("door")
        runtime.wait_door()
        runtime.idle()
        print("[6/6] 退出电梯", flush=True)
        require(runtime.navigate("exit"), "退出电梯")
    finally:
        runtime.close()

