def install_update(target):
    """Install this single-file update while preserving the site's literal DEFAULT_CONFIG."""
    source = Path(__file__).resolve()
    target = Path(target).expanduser().resolve()
    if source == target:
        raise ValueError("请先将新文件保存为 .updated.py，再用 --install-to 指定原入口")
    updated = source.read_text(encoding="utf-8")
    previous = None
    if target.exists():
        if not target.is_file():
            raise ValueError("更新目标不是普通文件")
        previous = target.read_text(encoding="utf-8-sig")
        def config_node(text):
            nodes = [node for node in ast.parse(text).body if isinstance(node, ast.Assign)
                     and any(isinstance(item, ast.Name) and item.id == "DEFAULT_CONFIG" for item in node.targets)]
            if len(nodes) != 1:
                raise ValueError("未找到唯一 DEFAULT_CONFIG，停止更新以保留现场文件")
            return nodes[0]
        old_node = config_node(previous)
        validate_config(ast.literal_eval(old_node.value))
        new_node = config_node(updated)
        lines = updated.splitlines(keepends=True)
        updated = "".join(lines[:new_node.lineno - 1]) + ast.get_source_segment(previous, old_node) + "\n" + "".join(lines[new_node.end_lineno:])
    compile(updated, str(target), "exec")
    backup = None
    if previous is not None:
        backup = target.with_name(target.name + ".backup_" + datetime.now().strftime("%Y%m%d_%H%M%S_") + uuid.uuid4().hex[:6])
        shutil.copy2(target, backup)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", newline="\n", dir=str(target.parent), delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(updated)
        if target.exists():
            shutil.copymode(target, temporary)
        os.replace(str(temporary), str(target))
    finally:
        if temporary is not None and temporary.exists():
            temporary.unlink()
    print("已更新：", target)
    print("保留现场 DEFAULT_CONFIG：", previous is not None)
    if backup:
        print("原文件备份：", backup)
    return 0


