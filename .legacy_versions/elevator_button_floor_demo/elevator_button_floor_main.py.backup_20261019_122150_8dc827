def check_connections(rospy, config, require_perception=True, require_navigation=True):
    """Read-only discovery and camera check. Never calls navigation/head services."""
    import rosgraph
    from sensor_msgs.msg import Image
    from std_msgs.msg import String
    publishers, subscribers, services = rosgraph.Master(rospy.get_name()).getSystemState()
    publishers, subscribers, services = dict(publishers), dict(subscribers), dict(services)
    p = config["perception"]
    required = [config["camera"]["topic"]]
    if require_perception:
        required += [p["door_state_topic"], p["extra_state_topic"], p["extra_ready_topic"]]
    missing = [name for name in required if not publishers.get(name)]
    for name in (("/move_base/move_to_target", "/move_base/check_arrived") if require_navigation else ()):
        if not services.get(name):
            missing.append(name)
    if require_navigation and not subscribers.get("/robot_head_motion_data"):
        missing.append("/robot_head_motion_data 的订阅者")
    if missing:
        raise RuntimeError("缺少连接：" + ", ".join(missing))
    if require_perception:
        for name in (p["door_mode_topic"], p["extra_request_topic"]):
            if not subscribers.get(name):
                raise RuntimeError("感知程序未订阅 " + name)
        ready = json.loads(rospy.wait_for_message(p["extra_ready_topic"], String, timeout=5).data)
        if ready.get("status") != "ready":
            raise RuntimeError("附加感知尚未就绪：" + str(ready.get("reason", ready.get("status"))))
        if ready.get("schema_version") != 1 or not {"button_verify", "floor_monitor"}.issubset(ready.get("capabilities", [])):
            raise RuntimeError("附加感知接口不兼容")
    message = rospy.wait_for_message(config["camera"]["topic"], Image, timeout=5)
    stamp = message.header.stamp.to_sec()
    if (message.height <= 0 or message.width <= 0 or message.step <= 0 or
            len(message.data) < message.height * message.step or stamp <= 0 or
            not -1 <= rospy.Time.now().to_sec() - stamp <= config["extra_perception"]["max_frame_age"]):
        raise RuntimeError("相机图像不完整、过期或时间戳异常")
    if publishers.get("/robot_head_motion_data"):
        print("头部话题当前发布者：" + ", ".join(publishers["/robot_head_motion_data"]))
        print("发布者注册不等于持续发送；若实测角度反复变化，再检查是否有其他程序覆盖指令。")
    print(f"相机连通：{message.width}x{message.height}，{message.encoding}；" +
          ("导航及头部接口已找到。" if require_navigation else "当前仅检查感知接口。"))


def prepare_ros_python_paths(book_dir):
    """Discover existing generated ROS bindings; never synthesize or install messages."""
    book = Path(book_dir).expanduser().resolve()
    prefixes = [Path(value) for value in os.environ.get("CMAKE_PREFIX_PATH", "").split(os.pathsep) if value]
    for ancestor in book.parents:
        if ancestor.name == "src":
            prefixes.extend((ancestor.parent / "devel", ancestor.parent / "install"))
            break
    prefixes.append(Path("/opt/ros/noetic"))
    candidates = []
    version = f"python{sys.version_info.major}.{sys.version_info.minor}"
    for prefix in prefixes:
        roots = [prefix]
        private = prefix / ".private"
        if private.is_dir():
            roots.extend(sorted(p for p in private.iterdir() if p.is_dir()))
        for root in roots:
            for python in ("python3", version):
                for kind in ("dist-packages", "site-packages"):
                    path = root / "lib" / python / kind
                    if path.is_dir() and path not in candidates:
                        candidates.append(path)
    for path in reversed(candidates):
        if str(path) not in sys.path:
            sys.path.insert(0, str(path))
    importlib.invalidate_caches()
    return candidates


def bootstrap_ros_environment(config):
    """Load the existing workspace before Python loads ROS native shared libraries."""
    if os.name != "posix":
        return
    workspace = next((path.parent for path in Path(config["book_dir"]).resolve().parents if path.name == "src"), None)
    if workspace is None or os.environ.get("KUAVO_ELEVATOR_ENV_READY") == str(workspace):
        return
    distro_setup, workspace_setup = Path("/opt/ros/noetic/setup.bash"), workspace / "devel/setup.bash"
    if not distro_setup.is_file() or not workspace_setup.is_file() or not Path(__file__).is_file():
        return
    environment = dict(os.environ)
    environment["KUAVO_ELEVATOR_ENV_READY"] = str(workspace)
    environment.setdefault("ROS_MASTER_URI", "http://kuavo_master:11311")
    print("加载现有 ROS / 工作空间环境，使用系统 Python；本步骤不发送机器人动作。", flush=True)
    script = 'source "$1" && source "$2" && exec "$3" "$4" "${@:5}"'
    os.execve("/bin/bash", ["bash", "--noprofile", "--norc", "-c", script, "elevator-ros-env",
                           str(distro_setup), str(workspace_setup), "/usr/bin/python3",
                           str(Path(__file__).resolve()), *sys.argv[1:]], environment)


def import_robot_api(config):
    book = Path(config["book_dir"])
    if not (book / "api.py").is_file():
        raise RuntimeError("未找到 book/api.py，请通过 --book-dir 指定现有生产接口目录")
    prepare_ros_python_paths(book)
    sys.path.insert(0, str(book))
    try:
        import api
    except ModuleNotFoundError as exc:
        if (exc.name or "").split(".")[0] == "leju_mobile_base_msgs":
            raise RuntimeError(
                "现有 book/api.py 的导航依赖 leju_mobile_base_msgs 未加载。"
                "已查找当前工作空间 devel/install 及 .private 中的 Python 消息绑定；"
                "请 source /opt/ros/noetic/setup.bash 和 /home/lab/kuavo-ros-control/devel/setup.bash，"
                "使用 /usr/bin/python3。仍失败时运行 --check-runtime 查看完整导入链；"
                "若生成目录中确实没有该包，需加载原底盘消息工作空间，不能伪造消息包跳过。"
            ) from exc
        raise
    if Path(api.__file__).resolve() != (book / "api.py").resolve():
        raise RuntimeError("导入了错误的 api.py")
    return api


def check_runtime(config):
    print("Python：", sys.executable, sys.version.split()[0])
    print("book：", config["book_dir"])
    for key in ("ROS_MASTER_URI", "ROS_IP", "CMAKE_PREFIX_PATH"):
