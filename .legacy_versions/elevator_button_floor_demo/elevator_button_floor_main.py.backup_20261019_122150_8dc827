class HeadFeedback:
    """Measured head angles for the verified version-62 wheel robot (20 joints)."""
    max_age = 0.5

    def __init__(self):
        self.lock = threading.Lock()
        self.sample = None
        self.reason = "尚未收到 /sensors_data_raw 的头部实测反馈"

    def feed(self, message, now, received_at):
        with self.lock:
            try:
                positions = message.joint_data.joint_q
                if len(positions) != 20:
                    raise ValueError(f"关节数量为 {len(positions)}，与已核对的 20 关节布局不符")
                stamp = finite(message.header.stamp.to_sec(), "反馈时间戳", 0.000001)
                if not -0.1 <= now - stamp <= self.max_age:
                    raise ValueError("关节反馈时间戳过期或时钟异常")
                yaw, pitch = [math.degrees(finite(v, "头部关节角度")) for v in positions[18:20]]
                if self.sample is not None and stamp <= self.sample["stamp"]:
                    return  # Repeated frames cannot extend stable-at-target time.
                self.sample = dict(stamp=stamp, received_at=received_at, yaw=yaw, pitch=pitch)
                self.reason = "实测反馈有效"
            except (AttributeError, TypeError, ValueError) as exc:
                self.sample = None
                self.reason = str(exc)

    def snapshot(self, now, wall_now):
        with self.lock:
            if self.sample is None:
                raise RuntimeError(self.reason)
            if (not -0.1 <= now - self.sample["stamp"] <= self.max_age or
                    not 0 <= wall_now - self.sample["received_at"] <= self.max_age):
                raise RuntimeError("头部实测反馈已过期，不能确认到位")
            return dict(self.sample)


class HeadMonitor:
    def __init__(self, rospy):
        from kuavo_msgs.msg import sensorsData
        # Do not silently reuse indices if this script is moved to another robot.
        if (rospy.get_param("/robot_version", None) != 62 or
                rospy.get_param("/robot_type", None) != 1 or
                rospy.get_param("/headRealDof", None) != 2):
            raise RuntimeError("头部反馈映射仅核对过 62 版轮臂、2 个头部关节，当前参数不匹配")
        self.rospy = rospy
        self.feedback = HeadFeedback()
        self.subscriber = rospy.Subscriber("/sensors_data_raw", sensorsData, self.on_feedback, queue_size=1)

    def on_feedback(self, message):
        self.feedback.feed(message, self.rospy.Time.now().to_sec(), time.monotonic())

    def snapshot(self):
        return self.feedback.snapshot(self.rospy.Time.now().to_sec(), time.monotonic())

    def wait_sample(self, timeout=2.0):
        deadline = time.monotonic() + timeout
        while not self.rospy.is_shutdown():
            try:
                return self.snapshot()
            except RuntimeError:
                if time.monotonic() >= deadline:
                    raise
                time.sleep(0.05)
        raise RuntimeError("ROS 已关闭")

    def close(self):
        self.subscriber.unregister()


def check_head(rospy):
    """Read feedback and controller output without constructing a command publisher."""
    from kuavo_msgs.msg import jointCmd
    ready = rospy.get_param("/hardware/is_ready", None)
    print("硬件就绪：/hardware/is_ready=", ready)
    monitor = HeadMonitor(rospy)
    try:
        measured = monitor.wait_sample()
        print(f"头部实测：yaw={measured['yaw']:.2f}°，pitch={measured['pitch']:.2f}°")
        try:
            rospy.wait_for_message("/joint_cmd", jointCmd, timeout=2.0)
            print("控制器输出：收到 /joint_cmd")
        except rospy.ROSException:
            raise RuntimeError("2 秒内未收到 /joint_cmd，头部控制链尚未正常输出；请核对整机初始化状态")
        require_head_ready(rospy)
        print("头部只读检查通过；未发送运动或初始化指令。")
    finally:
        monitor.close()


def move_head(head, pose, wait_seconds, rospy, monitor, name, timeout=None):
    """Send once through the original API; require fresh measured arrival and settling."""
    try:
        require_head_ready(rospy)
        monitor.wait_sample()
        deadline = time.monotonic() + 2
        while head.head_pub.get_num_connections() == 0:
            if rospy.is_shutdown() or time.monotonic() >= deadline:
                raise RuntimeError("头部话题没有订阅者，未发送头部指令")
            time.sleep(0.05)
        if rospy.is_shutdown():
            raise RuntimeError("ROS 已关闭，头部动作中止")
        require_head_ready(rospy)
        sent_stamp = rospy.Time.now().to_sec()
        if not head.control_head(pose["yaw"], pose["pitch"]):
            raise RuntimeError("HeadAPI 拒绝头部指令")
        print(f"[{name}] 目标 yaw={pose['yaw']}°，pitch={pose['pitch']}°；等待实测到位", flush=True)
        deadline = time.monotonic() + (max(10.0, wait_seconds + 5.0) if timeout is None else timeout)
        stable_since, stable_wall, samples, previous_stamp, last_report = None, None, 0, None, -math.inf
        while True:
            if rospy.is_shutdown():
                raise RuntimeError("ROS 已关闭，头部动作中止")
            require_head_ready(rospy)
            measured = monitor.snapshot()  # Missing/stale feedback aborts rather than declaring success.
            now = time.monotonic()
            error = max(abs(measured[axis] - pose[axis]) for axis in ("yaw", "pitch"))
            fresh = measured["stamp"] > sent_stamp
            if fresh and error <= 2.0:
                if measured["stamp"] != previous_stamp:
                    samples += 1
                    previous_stamp = measured["stamp"]
                    stable_since = measured["stamp"] if stable_since is None else stable_since
                    stable_wall = now if stable_wall is None else stable_wall
                if (samples >= 3 and measured["stamp"] - stable_since >= wait_seconds and
                        now - stable_wall >= wait_seconds):
                    print(f"[{name}] 实测到位：yaw={measured['yaw']:.2f}°，pitch={measured['pitch']:.2f}°", flush=True)
                    return measured
            else:
                stable_since, stable_wall, samples, previous_stamp = None, None, 0, None
            description = f"实测 yaw={measured['yaw']:.2f}°，pitch={measured['pitch']:.2f}°，最大误差={error:.2f}°"
            if now >= deadline:
                raise TimeoutError(f"头部未到位：{description}；停止后续感知与导航")
            if now - last_report >= 1:
                print(f"[{name}] {description}", flush=True)
                last_report = now
            time.sleep(0.05)
    except Exception as exc:
        raise RuntimeError(f"{name} 失败（目标 yaw={pose['yaw']}°，pitch={pose['pitch']}°）：{exc}") from exc


class LiveRuntime:
    def __init__(self, config, log_dir, perception_required=True, head_required=True):
        import rospy
        from py_trees.common import Status
        from std_msgs.msg import String
        self.config, self.rospy, self.Status, self.String = config, rospy, Status, String
        self.target_floor = config["target_floor"]
        self.api = import_robot_api(config)
        if head_required:
            require_head_ready(rospy)  # Fail before the first navigation command.
        check_connections(rospy, config, require_perception=perception_required, require_navigation=head_required)
        self.head_monitor = HeadMonitor(rospy) if head_required else None
        if self.head_monitor is not None:
            try:
                self.head_monitor.wait_sample()
            except Exception:
                self.head_monitor.close()
                raise
        self.head = self.api.HeadAPI(None) if head_required else None
        p = config["perception"]
        self.door_pub = rospy.Publisher(p["door_mode_topic"], String, queue_size=1, latch=True)
        self.extra_pub = rospy.Publisher(p["extra_request_topic"], String, queue_size=1, latch=True)
        self.gates = {}
        self.active_observation = None
        for name in ("button", "floor", "door"):
            rule = p[name]
            self.gates[name] = EvidenceGate(p["max_result_age"], p["min_confidence"],
                                            rule["confirmations"], rule["min_span"])
        self.subscribers = [
            rospy.Subscriber(p["door_state_topic"], String, lambda msg: self.on_state("door", msg), queue_size=10),
            rospy.Subscriber(p["extra_state_topic"], String, self.on_extra, queue_size=10),
        ]
        log_dir.mkdir(parents=True, exist_ok=True)
        self.log_path = log_dir / (datetime.now().strftime("elevator_%Y%m%d_%H%M%S_") + uuid.uuid4().hex[:6] + ".jsonl")
        self.current_request = None
        self.pause(0.5)

    def record(self, event, **data):
        payload = {"system_stamp": time.time(), "ros_stamp": self.now(),
                   "monotonic": time.monotonic(), "event": event, **data}
        if getattr(self, "telemetry", False):
            # SSH stdout is the reliable ordered transport to the upper recorder.
            with self.event_lock:
                self.event_sequence += 1
                payload.update(run_id=self.run_id, event_sequence=self.event_sequence)
                sys.stdout.write("__ELEVATOR_EVENT__" + json.dumps(payload, ensure_ascii=False, allow_nan=False) + "\n")
                sys.stdout.flush()
        else:
            with self.log_path.open("a", encoding="utf-8") as stream:
                stream.write(json.dumps(payload, ensure_ascii=False, allow_nan=False) + "\n")

    def now(self):
        return self.rospy.Time.now().to_sec()

    def on_state(self, name, message):
        if name != self.active_observation:
            return
        gate = self.gates[name]
        gate.feed(message.data, self.now())
        self.rospy.loginfo_throttle(2, "%s: %s", name, gate.reason)

    def on_extra(self, message):
        for name in ("button", "floor"):
            self.on_state(name, message)

    def pause(self, seconds):
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            if self.rospy.is_shutdown():
                raise RuntimeError("ROS 已关闭")
            time.sleep(min(0.05, max(0, deadline - time.monotonic())))

    def extra_request(self, mode, stamp=None):
        request = {"request_id": uuid.uuid4().hex, "mode": mode,
                   "not_before_stamp": self.now() if stamp is None else stamp}
        self.current_request = request
        self.extra_pub.publish(self.String(data=json.dumps(request)))
        return request

    def idle(self):
        self.active_observation = None
        self.door_pub.publish(self.String(data="idle"))
        self.extra_request("idle")

    def look(self, name):
        self.idle()  # In-flight inference is invalidated before moving the head.
        pose = self.config["head"][name]
        self.record("head", view=name, **pose)
        try:
            measured = move_head(self.head, pose, self.config["head_settle_seconds"],
                                 self.rospy, self.head_monitor, "ElevatorDemo_Look_" + name)
            self.record("head_reached", view=name, measured=measured)
        except Exception as exc:
            self.record("head_failed", view=name, reason=str(exc))
            raise

    def wait_extra(self, name, mode, field, expected):
        self.door_pub.publish(self.String(data="idle"))
        stamp = self.now()  # Only frames captured after head settling may satisfy the gate.
        request_id = uuid.uuid4().hex
        request = {"request_id": request_id, "mode": mode, "not_before_stamp": stamp}
        gate = self.gates[name]
        gate.arm(mode, field, expected, stamp, request_id=request_id)
        self.active_observation = name
        self.current_request = request
        self.extra_pub.publish(self.String(data=json.dumps(request)))
        self.record("observe_start", **request, expected=expected)
        result = gate.wait(self.config["perception"][name + "_timeout"], self.now, self.rospy.is_shutdown)
        self.record("observe_confirmed", result=result)
        return result

    def wait_button(self):
        return self.wait_extra("button", "button_verify", "button_lit", True)

    def wait_floor(self):
        return self.wait_extra("floor", "floor_monitor", "floor", self.config["target_floor"])

    def wait_door(self):
        self.extra_request("idle")
        gate = self.gates["door"]
        gate.arm("door_monitor", "door_closed", False, self.now(), schema_version=2)
        self.active_observation = "door"
        self.record("door_wait_start")
        self.door_pub.publish(self.String(data="door_monitor"))
        result = gate.wait(self.config["perception"]["door_timeout"], self.now, self.rospy.is_shutdown)
        self.record("door_confirmed", result=result)
        return result

    def navigate(self, name):
        self.idle()
        require_head_ready(self.rospy)
        pose = self.config["points"][name]
        options = dict(self.config["navigation"])
        timeout = options.pop("timeout")
        sender = self.api.NodeNavigationToTarget(name="ElevatorDemo_" + name, **pose, **options)
        waiter = self.api.NodeWaitForArrival("ElevatorDemo_" + name + "_Arrival", timeout=timeout)
        motion = getattr(self, "motion", None)
        if motion is not None:
            motion.prepare(name)
        deadline = time.monotonic() + timeout
        self.record("navigation_start", point=name, pose=pose)
        try:
            for node in (sender, waiter):
                if node is sender:
                    self.record("command_issue", point=name, pose=pose)
                    if motion is not None:
                        motion.arm()
                while True:
                    if self.rospy.is_shutdown() or time.monotonic() >= deadline:
                        self.record("navigation_failed", point=name, reason="timeout_or_shutdown")
                        return False
                    node.tick_once()
                    if node.status == self.Status.SUCCESS:
                        self.record("command_accepted" if node is sender else "arrival_reported", point=name)
                        break
                    if node.status == self.Status.FAILURE:
                        self.record("navigation_failed", point=name, reason="api_failure")
                        return False
                    time.sleep(0.05)
            self.pause(self.config["settle_seconds"])
            self.record("navigation_arrived", point=name)
            return True
        finally:
            if motion is not None:
                motion.disarm()
            for node in (sender, waiter):
                if node.status == self.Status.RUNNING:
                    node.stop(self.Status.INVALID)

    def close(self):
        try:
            self.idle()
            self.record("finished_or_aborted")
            if not self.rospy.is_shutdown():
                self.pause(0.2)
        finally:
            if self.head_monitor is not None:
                self.head_monitor.close()
            for subscriber in self.subscribers:
                subscriber.unregister()
            if getattr(self, "motion", None) is not None:
                self.motion.close()
            print("运行记录：" + ("已通过 SSH 保存到上位机 result" if getattr(self, "telemetry", False) else str(self.log_path)))


class MotionMonitor:
    """Measured base displacement, never command velocity, defines motion onset."""
    def __init__(self, runtime, topic, distance=0.015, angle=0.03):
        import rostopic
        self.runtime, self.topic = runtime, topic
        self.distance, self.angle = distance, angle
        self.lock = threading.RLock()
        self.samples, self.pending = [], None
        message_class, _, _ = rostopic.get_topic_class(topic, blocking=False)
        if message_class is None or message_class._type not in ("geometry_msgs/PoseStamped", "nav_msgs/Odometry"):
            raise RuntimeError("运动反馈须为实时 PoseStamped/Odometry：" + topic)
        self.subscriber = runtime.rospy.Subscriber(topic, message_class, self.on_sample, queue_size=100)

    @staticmethod
    def delta(a, b):
        return math.hypot(a[0] - b[0], a[1] - b[1]), abs(math.atan2(math.sin(a[2] - b[2]), math.cos(a[2] - b[2])))

    def on_sample(self, message):
        now, mono = self.runtime.now(), time.monotonic()
        stamp = message.header.stamp.to_sec()
        if not math.isfinite(stamp) or not -0.1 <= now - stamp <= 0.5:
            return
        pose = message.pose.pose if hasattr(message.pose, "pose") else message.pose
        p, q = pose.position, pose.orientation
        values = (p.x, p.y, q.x, q.y, q.z, q.w)
        if not all(math.isfinite(v) for v in values) or abs(sum(v*v for v in values[2:]) - 1) > 0.1:
            return
        yaw = math.atan2(2*(q.w*q.z + q.x*q.y), 1 - 2*(q.y*q.y + q.z*q.z))
        sample = {"pose": (p.x, p.y, yaw), "stamp": stamp, "mono": mono, "frame": message.header.frame_id}
        with self.lock:
            if self.samples and stamp <= self.samples[-1]["stamp"]:
                return
            self.samples.append(sample)
            self.samples = [s for s in self.samples[-200:] if mono - s["mono"] <= 2]
            pending = self.pending
            if pending is None or stamp <= pending["armed_ros"]:
                return
            self.runtime.record("motion_sample", point=pending["point"], topic=self.topic,
                                sample_stamp=stamp, pose=sample["pose"], frame=sample["frame"])
            baseline = pending["baseline"]
            if sample["frame"] != baseline["frame"]:
                pending["invalid"] = "feedback_frame_changed"
            previous = pending["previous"]
            displacement, rotation = self.delta(sample["pose"], previous["pose"])
            if mono - previous["mono"] > 0.5 or displacement > 0.25 or rotation > 0.25:
                pending["invalid"] = "feedback_gap_or_jump"
            pending["previous"] = sample
            if pending.get("invalid") or pending.get("detected"):
                return
            displacement, rotation = self.delta(sample["pose"], baseline["pose"])
            if displacement >= self.distance or rotation >= self.angle:
                pending["above"].append(sample)
                if len(pending["above"]) >= 3:
                    first = pending["above"][0]
                    pending["detected"] = True
                    self.runtime.record("motion_started", point=pending["point"], topic=self.topic,
                                        onset_monotonic=first["mono"], onset_ros_stamp=first["stamp"],
                                        distance_m=displacement, rotation_rad=rotation,
                                        threshold_m=self.distance, threshold_rad=self.angle)
            else:
                pending["above"] = []

    def prepare(self, point):
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline:
            with self.lock:
                recent = [s for s in self.samples if time.monotonic() - s["mono"] <= 0.5]
                if len(recent) >= 3 and recent[-1]["mono"] - recent[0]["mono"] >= 0.2:
                    baseline = recent[-1]
                    if (all(s["frame"] == baseline["frame"] and
                            self.delta(s["pose"], baseline["pose"])[0] < self.distance / 2 and
                            self.delta(s["pose"], baseline["pose"])[1] < self.angle / 2 for s in recent) and
                            -0.1 <= self.runtime.now() - baseline["stamp"] <= 0.5):
                        self.prepared = dict(point=point, baseline=baseline, previous=baseline, above=[])
                        return
            self.runtime.pause(0.05)
        raise RuntimeError("运动反馈缺失、过期或底盘未静止，无法量化起步：" + self.topic)

    def arm(self):
        with self.lock:
            self.pending = dict(self.prepared, armed_ros=self.runtime.now())

    def disarm(self):
        with self.lock:
            if self.pending is not None:
                previous = self.pending["previous"]
                if time.monotonic() - previous["mono"] > 0.5 or not -0.1 <= self.runtime.now() - previous["stamp"] <= 0.5:
                    self.pending["invalid"] = "feedback_stale_at_end"
                self.runtime.record("motion_measurement_end", point=self.pending["point"],
                                    reason=self.pending.get("invalid") or
                                    ("detected" if self.pending.get("detected") else "onset_not_observed"))
            self.pending = None

    def close(self):
        self.disarm()
        self.subscriber.unregister()


class MockRuntime:
    def __init__(self, target_floor=20):
        self.target_floor = target_floor
        self.events = []

    def navigate(self, point):
        self.events.append(("navigate", point))
        return True

    def look(self, view):
        self.events.append(("head", view))

    def idle(self):
        self.events.append(("mode", "idle"))

    def wait_button(self):
        self.events.append(("wait", "down_button_lit"))

    def wait_floor(self):
        self.events.append(("wait", f"floor_{self.target_floor}"))

    def wait_door(self):
        self.events.append(("wait", "door_fully_open"))

    def close(self):
        self.events.append(("close",))


def validate_live(config, args):
    if config["calibrated"] is not True:
        raise ValueError("新按钮坐标/头部视角尚未标定；核对后将本文件 DEFAULT_CONFIG 的 calibrated 改为 True")
    if not (args.preflight_confirmed and args.perception_confirmed and args.estop_ready):
        raise ValueError("实机沿用原程序三个参数：--preflight-confirmed --perception-confirmed --estop-ready")


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, help="可选外部 JSON；默认使用本文件 DEFAULT_CONFIG")
    parser.add_argument("--target-floor", type=int, help="本次目标楼层，覆盖所选配置中的 target_floor；不改变地图或按钮方向")
    parser.add_argument("--book-dir", type=Path)
    parser.add_argument("--log-dir", type=Path, default=ROOT / "logs")
    parser.add_argument("--quantify", action="store_true", help="向上位机输出量化事件并启用实测运动反馈")
    parser.add_argument("--run-id", default="manual")
    parser.add_argument("--entry-plan", choices=("baseline", "reduced_backtrack", "center_shift"), default="baseline")
    parser.add_argument("--entry-pose", type=float, nargs=3, metavar=("X", "Y", "THETA"), help="现场核对的厅外观察点，米/度")
    parser.add_argument("--entry-only", action="store_true", help="完成进梯即结束，不继续楼层和出梯")
    parser.add_argument("--motion-topic", default="/tracked_pose")
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--run", action="store_true")
    modes.add_argument("--mock", action="store_true")
    modes.add_argument("--check-services", action="store_true")
    modes.add_argument("--check-head", action="store_true", help="只读检查头部硬件就绪、实测角度和控制器输出")
    modes.add_argument("--check-motion", action="store_true", help="只读检查定位反馈新鲜且静止，不发布运动指令")
    modes.add_argument("--check-runtime", action="store_true", help="仅检查机器人接口依赖，输出完整错误链，不发送动作")
    modes.add_argument("--install-to", type=Path, help="安装本文件补丁到指定原入口，保留原 DEFAULT_CONFIG 并备份")
    modes.add_argument("--observe-only", choices=("button", "floor", "door"), help="保持现有姿态，仅测试感知；不导航、不转头")
    modes.add_argument("--head-only", choices=("button", "floor", "door"), help="只发送一次头部姿态，不导航；用于标定")
    for name in ("preflight-confirmed", "perception-confirmed", "estop-ready"):
        parser.add_argument("--" + name, action="store_true")
    args = parser.parse_args(argv)
    if args.install_to:
        return install_update(args.install_to)
    config = load_config(args.config)
    print("参数来源：" + (str(args.config) if args.config else "本文件 DEFAULT_CONFIG（内置）"))
    if args.target_floor is not None:
        config["target_floor"] = args.target_floor
        validate_config(config)
        print("本次目标楼层由 --target-floor 覆盖：", config["target_floor"])
    if args.book_dir:
        config["book_dir"] = str(args.book_dir)
    if not args.quantify and (args.entry_plan != "baseline" or args.entry_pose or args.entry_only):
        parser.error("进梯方案参数仅用于 --quantify")
    if args.entry_plan != "baseline" and args.entry_pose is None:
        parser.error("新方案必须用 --entry-pose 给出现场核对过的观察点，不能猜测门中心坐标")
    if args.entry_plan == "baseline" and args.entry_pose is not None:
        parser.error("baseline 使用原 origin；自定义观察点请选择 reduced_backtrack 或 center_shift")
    entry_point = "origin"
    if args.entry_pose is not None:
        entry_point = "entry_wait"
        x, y, theta = args.entry_pose
        config["points"][entry_point] = dict(x=finite(x, "entry.x"), y=finite(y, "entry.y"),
                                             theta=finite(theta, "entry.theta", -180, 180))
    if args.check_runtime:
        bootstrap_ros_environment(config)
        return check_runtime(config)
    if args.mock:
        runtime = MockRuntime(config["target_floor"])
        execute_demo(runtime, entry_point, args.entry_only)
        print("[MOCK] " + " -> ".join(map(str, runtime.events)))
        print("模拟完成；未连接 ROS、未发送运动或真实感知请求。")
        return 0
    if not any((args.run, args.check_services, args.check_head, args.check_motion, args.observe_only, args.head_only)):
        print("仅预览：未连接机器人。导航单位为米，角度为度。")
        for name, pose in config["points"].items():
            print(name, pose)
        print("头部姿态：", config["head"])
        print(f"目标楼层：{config['target_floor']}；厅外下行按钮未亮则等待；本程序不按任何按钮。")
        print(f"当前地图：{config['map_name']}；仍使用所选配置的局部进出梯坐标，不自动切图。")
        print("新点位/视角标定状态：", config["calibrated"])
        return 0
    if args.run:
        validate_live(config, args)
    if args.head_only and not args.estop_ready:
        raise ValueError("头部标定需沿用 --estop-ready；本模式不移动底盘")
    bootstrap_ros_environment(config)
    prepare_ros_python_paths(config["book_dir"])
    import rospy
    rospy.init_node("elevator_button_floor_demo", anonymous=True, disable_signals=True)
    signal.signal(signal.SIGINT, signal.default_int_handler)
    signal.signal(signal.SIGTERM, signal.default_int_handler)
    if args.check_motion:
        from types import SimpleNamespace
        probe = SimpleNamespace(rospy=rospy, now=lambda: rospy.Time.now().to_sec(),
                                pause=lambda seconds: time.sleep(seconds), record=lambda *a, **kw: None)
        monitor = MotionMonitor(probe, args.motion_topic)
        try:
            monitor.prepare("read_only_check")
            print("运动反馈已连通、新鲜且静止：" + args.motion_topic)
        finally:
            monitor.close()
        return 0
    if args.check_head:
        check_head(rospy)
        return 0
    if args.check_services:
        import_robot_api(config)
        check_connections(rospy, config)
        print("只读连接检查完成；未发送导航、头部、按键或切图指令。")
        return 0
    if args.head_only:
        require_head_ready(rospy)
        api = import_robot_api(config)
        monitor = HeadMonitor(rospy)
        try:
            monitor.wait_sample()
            head = api.HeadAPI(None)
            pose = config["head"][args.head_only]
            move_head(head, pose, config["head_settle_seconds"],
                      rospy, monitor, "ElevatorDemo_Calibrate_" + args.head_only)
        finally:
            monitor.close()
        print("仅头部标定完成；未移动底盘。")
        return 0
    runtime = LiveRuntime(config, args.log_dir, head_required=not bool(args.observe_only))
    if args.quantify:
        runtime.telemetry, runtime.run_id = True, args.run_id
        runtime.event_lock, runtime.event_sequence = threading.RLock(), 0
        runtime.record("quantification_start", config=config, entry_plan=args.entry_plan,
                       entry_only=args.entry_only, motion_topic=args.motion_topic)
        if not args.observe_only:
            try:
                runtime.motion = MotionMonitor(runtime, args.motion_topic)
            except BaseException:
                runtime.close()
                raise
    if args.observe_only:
        try:
            runtime.idle()
            result = {"button": runtime.wait_button, "floor": runtime.wait_floor, "door": runtime.wait_door}[args.observe_only]()
            print(json.dumps(result, ensure_ascii=False))
        finally:
            runtime.close()
    else:
        execute_demo(runtime, entry_point, args.entry_only)
        print("单轮演示完成。")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("测试中断；退出脚本不保证底盘停车，沿用原程序的现场急停处理。")
        raise SystemExit(130)
    except Exception as error:
        print("测试未启动或已终止：" + str(error), file=sys.stderr)
        raise SystemExit(1)
