.env
.env.*
*.env
*.pem
*.key
id_ed25519*
id_rsa*
secrets/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/
logs/
log/
runtime/
result/
.result_pending/
*.log
*.lock
build/
devel/
install/
.catkin_tools/
*.bag
*.db3
*.mp4
*.avi
*.pt
*.pth
*.onnx
*.safetensors
